{
  "name": "colmaputil-send",
  "displayName": "Send to ColmapUtil",
  "description": "Open ColmapUtil web app from Explorer folder context menu.",
  "version": "0.0.5",
  "publisher": "kiri-innov",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiri-Innovation/ColmapUtil.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "extensionKind": ["workspace", "ui"],
  "activationEvents": [
    "onCommand:colmaputil.sendToColmapUtil",
    "onCommand:colmaputil.sendToColmapUtilNoImage"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "colmaputil.sendToColmapUtil",
        "title": "Send to ColmapUtil"
      },
      {
        "command": "colmaputil.sendToColmapUtilNoImage",
        "title": "Send to ColmapUtil (NoImage)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "colmaputil.sendToColmapUtil",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "colmaputil.sendToColmapUtilNoImage",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "package": "yarn install --ignore-scripts && npx --yes @vscode/vsce package --allow-missing-repository",
    "install-to-cursor": "node scripts/install-to-cursor.js",
    "install-local": "yarn package && yarn install-to-cursor",
    "release": "node scripts/release.js"
  },
  "devDependencies": {},
  "dependencies": { "archiver": "^7.0.1" }
}
